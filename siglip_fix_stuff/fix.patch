+/// Resolve the tokenizer's pad token id from the tokenizer files in `model_path`.
+///
+/// Tries, in order:
+/// 1. the explicit `padding.pad_id` in `tokenizer.json` (present when the checkpoint
+///    ships a padding strategy, e.g. the SigLIP2 fixed-to-64 padding);
+/// 2. the `pad_token` declared in `tokenizer_config.json` (plain string or
+///    `AddedToken`-style object), mapped to its id via the `added_tokens` section of
+///    `tokenizer.json`.
+///
+/// Returns `None` if neither source is available, in which case callers should keep
+/// the id from `config.json`.
+fn resolve_siglip_pad_token_id(model_path: &Path) -> Option<u32> {
+    let tokenizer: serde_json::Value =
+        serde_json::from_str(&std::fs::read_to_string(model_path.join("tokenizer.json")).ok()?)
+            .ok()?;
+
+    if let Some(pad_id) = tokenizer
+        .get("padding")
+        .and_then(|p| p.get("pad_id"))
+        .and_then(|v| v.as_u64())
+    {
+        return Some(pad_id as u32);
+    }
+
+    let tokenizer_config: serde_json::Value = serde_json::from_str(
+        &std::fs::read_to_string(model_path.join("tokenizer_config.json")).ok()?,
+    )
+    .ok()?;
+    let pad_token = tokenizer_config.get("pad_token")?;
+    let pad_token = pad_token
+        .as_str()
+        .or_else(|| pad_token.get("content").and_then(|v| v.as_str()))?;
+
+    tokenizer
+        .get("added_tokens")?
+        .as_array()?
+        .iter()
+        .find(|token| token.get("content").and_then(|v| v.as_str()) == Some(pad_token))
+        .and_then(|token| token.get("id").and_then(|v| v.as_u64()))
+        .map(|id| id as u32)
+}
